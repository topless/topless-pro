{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topless-pro",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-24",
  "routes": [
    {
      "pattern": "topless.pro",
      "custom_domain": true
    },
    {
      "pattern": "www.topless.pro",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "topless-pro-db",
      "database_id": "dcb94578-9182-45e6-b2fa-9d946614f149",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CORRECTION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
